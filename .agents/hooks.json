{
  "dynamic-notch-integration": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/Users/luisangelceroncastro/Documents/Dynamic Notch/scripts/antigravity_hook.py\" pre_tool",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/Users/luisangelceroncastro/Documents/Dynamic Notch/scripts/antigravity_hook.py\" post_tool",
            "timeout": 10
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 \"/Users/luisangelceroncastro/Documents/Dynamic Notch/scripts/antigravity_hook.py\" session_start",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 \"/Users/luisangelceroncastro/Documents/Dynamic Notch/scripts/antigravity_hook.py\" stop",
        "timeout": 10
      }
    ]
  }
}
